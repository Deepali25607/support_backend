# Copy this file to .env for local development and fill in real values.
# In production (Render), set these in the dashboard under Environment, NOT in a file.

# MongoDB Atlas connection string (free M0 tier).
# Get it from Atlas: Database > Connect > Drivers. Replace <password> with your
# database user's password and keep the database name in the path.
# Without this, the app falls back to a local data.json that is WIPED on every
# deploy/restart on Render's free tier.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/support?retryWrites=true&w=majority

# Name of the database to use inside the cluster (defaults to "support").
MONGODB_DB=support

# Port the server listens on (Render sets this automatically; 3000 locally).
PORT=3000
